{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "perplexity-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-17",
  "workers_dev": true,
  "preview_urls": false,
  "vars": { "OWNER_EMAIL": "" },
  "durable_objects": {
    "bindings": [{ "name": "OWNER_STATE", "class_name": "OwnerState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OwnerState"] }]
}
