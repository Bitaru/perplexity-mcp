{
  "name": "perplexity-mcp-cloudflare",
  "version": "0.1.0",
  "private": true,
  "description": "Owner-only Perplexity MCP Worker template for Cloudflare.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check-template": "node --experimental-strip-types scripts/check-template.ts",
    "check-secrets": "node --experimental-strip-types scripts/check-secrets.ts",
    "smoke": "vitest run tests/smoke.test.ts",
    "diagnose": "node --experimental-strip-types scripts/diagnose.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260917.1",
    "@types/node": "22.20.3",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "wrangler": "4.133.0"
  },
  "cloudflare": {
    "bindings": {
      "OWNER_STATE": {
        "type": "durable_object_namespace",
        "class_name": "OwnerState",
        "description": "Singleton owner/provider state in an encrypted-at-rest SQLite-backed Durable Object."
      },
      "OWNER_EMAIL": {
        "type": "plain_text",
        "description": "Required owner email. It must exactly match the Cloudflare Access identity."
      }
    }
  }
}
